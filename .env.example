# External asset directory populated by `exroma assets pull` or selected with
# `exroma assets link /path/to/ExRoMa-Assets`.
EXROMA_ASSET_ROOT=$HOME/.cache/exroma/assets

# Isaac Lab checkout used to launch simulation commands.
EXROMA_ISAACLAB_ROOT=$HOME/robotics/IsaacLab

# Optional real-robot safety gate. Real commands refuse motion unless enabled.
EXROMA_REAL_ROBOT_ENABLED=0
